# Local development only. Do not commit Laundry_Berkah/.env.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# TiDB/MySQL: use DATABASE_URL, or set the individual values below.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/DATABASE
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB=db_laundry
# For Vercel, paste the PEM certificate as TIDB_SSL_CA_CONTENT in Project Settings.
TIDB_SSL_CA_CONTENT=

# Fonnte WhatsApp (use the device token, not an account token).
FONTE_TOKEN=
FONTE_API_URL=https://api.fonnte.com/send
FONTE_PHONE=

# Needed to attach receipt images in WhatsApp; text messages still work without it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional service configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=
MERCHANT_NAME=Laundry Berkah
MERCHANT_ADDRESS=
MERCHANT_PHONE=
